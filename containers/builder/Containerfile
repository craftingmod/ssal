FROM rust:1.90.0-bookworm@sha256:3914072ca0c3b8aad871db9169a651ccfce30cf58303e5d6f2db16d1d8a7e58f

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates curl unzip zip git build-essential pkg-config cmake ninja-build \
    python3 file binutils e2fsprogs util-linux shellcheck \
    && rm -rf /var/lib/apt/lists/*

# Google publishes this checksum alongside NDK r30 for Linux x86_64.
RUN curl -fsSL https://dl.google.com/android/repository/android-ndk-r30-linux.zip -o /tmp/ndk.zip \
    && echo '5107f898313790e449e87eee2183d9a20602dee9  /tmp/ndk.zip' | sha1sum -c - \
    && unzip -q /tmp/ndk.zip -d /opt \
    && mv /opt/android-ndk-r30 /opt/android-ndk \
    && rm /tmp/ndk.zip
RUN rustup target add aarch64-linux-android && rustup component add rustfmt clippy
ENV ANDROID_NDK_HOME=/opt/android-ndk \
    CARGO_TARGET_DIR=/build/target \
    CC_aarch64_linux_android=/opt/android-ndk/toolchains/llvm/prebuilt/linux-x86_64/bin/aarch64-linux-android26-clang \
    AR_aarch64_linux_android=/opt/android-ndk/toolchains/llvm/prebuilt/linux-x86_64/bin/llvm-ar
WORKDIR /src
